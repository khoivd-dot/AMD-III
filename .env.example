# Leave HOMEWARD_LLM_BASE_URL empty to run in replay mode (no GPU needed).
HOMEWARD_LLM_BASE_URL=http://YOUR-DROPLET-IP:8000/v1
HOMEWARD_LLM_API_KEY=change-me
HOMEWARD_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
HOMEWARD_HARDWARE=AMD Instinct MI300X (192 GB) · vLLM · ROCm
# Set to 1 to save outputs of sample cases for replay.
HOMEWARD_RECORD=0
